# CORS preflight handler shared by stats and visualizer microservices.
# We answer OPTIONS in Caddy itself instead of forwarding to nginx upstream,
# whose CORS is hard-coded to http://localhost(:3000) in proxy/*.conf.template.
(blockscout_cors_preflight) {
	@cors_preflight method OPTIONS
	handle @cors_preflight {
		header Access-Control-Allow-Origin      "https://evm-explorer.gleec.com"
		header Access-Control-Allow-Credentials "true"
		header Access-Control-Allow-Methods     "PUT, GET, POST, OPTIONS, DELETE, PATCH"
		header Access-Control-Allow-Headers     "DNT,Keep-Alive,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization,x-csrf-token"
		header Access-Control-Max-Age           "1728000"
		respond 204
	}
}

# Legacy Cloudflare hostname: always send clients to the current explorer domain.
# TLS for explorer.gleec.cloud uses certs under ssl/gleec.cloud (mounted at /etc/caddy/ssl).
http://explorer.gleec.cloud {
	redir https://evm-explorer.gleec.com{uri} permanent
}

explorer.gleec.cloud {
	tls /etc/caddy/ssl/gleec.cloud/ssl.pem /etc/caddy/ssl/gleec.cloud/ssl.key

	redir https://evm-explorer.gleec.com{uri} permanent
}

evm-explorer.gleec.com {
	tls /etc/caddy/ssl/gleec.com/ssl.pem /etc/caddy/ssl/gleec.com/ssl.key

	encode zstd gzip

	log {
		output stdout
		format json
	}

	reverse_proxy proxy:80 {
		header_up Host            {host}
		header_up X-Real-IP       {client_ip}
		header_up X-Forwarded-For {client_ip}
	}
}

# Stats microservice: nginx :8080 inside `proxy` -> stats:8050
evm-stats.gleec.com {
	tls /etc/caddy/ssl/gleec.com/ssl.pem /etc/caddy/ssl/gleec.com/ssl.key

	encode zstd gzip

	log {
		output stdout
		format json
	}

	import blockscout_cors_preflight

	reverse_proxy proxy:8080 {
		header_up Host            {host}
		header_up X-Real-IP       {client_ip}
		header_up X-Forwarded-For {client_ip}

		header_down -Access-Control-Allow-Methods
		header_down -Access-Control-Allow-Headers
		header_down >Access-Control-Allow-Origin      "https://evm-explorer.gleec.com"
		header_down >Access-Control-Allow-Credentials "true"
	}
}

# Visualizer microservice: nginx :8081 inside `proxy` -> visualizer:8050
# Long timeouts mirror proxy_*_timeout 30m + proxy_buffering off from
# proxy/microservices.conf.template.
evm-viz.gleec.com {
	tls /etc/caddy/ssl/gleec.com/ssl.pem /etc/caddy/ssl/gleec.com/ssl.key

	encode zstd gzip

	log {
		output stdout
		format json
	}

	import blockscout_cors_preflight

	reverse_proxy proxy:8081 {
		header_up Host            {host}
		header_up X-Real-IP       {client_ip}
		header_up X-Forwarded-For {client_ip}

		header_down -Access-Control-Allow-Methods
		header_down -Access-Control-Allow-Headers
		header_down >Access-Control-Allow-Origin      "https://evm-explorer.gleec.com"
		header_down >Access-Control-Allow-Credentials "true"

		flush_interval -1
		transport http {
			dial_timeout  30s
			read_timeout  30m
			write_timeout 30m
		}
	}
}
